{
  "id": null,
  "uid": "notification-service",
  "title": "Notification Service Dashboard",
  "tags": ["notification", "websocket", "rabbitmq"],
  "timezone": "browser",
  "refresh": "10s",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "title": "Service Health",
      "type": "stat",
      "datasource": "prometheus",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "up{job=\"notification-service\"}",
          "legendFormat": "Service Status"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Down", "color": "red" },
                "1": { "text": "Up", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "red" },
              { "value": 1, "color": "green" }
            ]
          }
        }
      }
    },
    {
      "title": "WebSocket Connections",
      "type": "graph",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "socket_io_connected_clients",
          "legendFormat": "Connected Clients"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Clients",
          "min": 0
        }
      ],
      "alert": {
        "name": "High Connection Count",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [1000]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": ["A", "5m", "now"]
            },
            "reducer": {
              "type": "avg"
            },
            "type": "query"
          }
        ]
      }
    },
    {
      "title": "Message Processing Rate",
      "type": "graph",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 4
      },
      "targets": [
        {
          "expr": "rate(notification_messages_processed_total[5m])",
          "legendFormat": "Messages/sec"
        }
      ],
      "yaxes": [
        {
          "format": "ops",
          "label": "Messages/sec"
        }
      ]
    },
    {
      "title": "Message Processing Latency",
      "type": "graph",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, rate(notification_processing_duration_seconds_bucket[5m]))",
          "legendFormat": "95th Percentile"
        }
      ],
      "yaxes": [
        {
          "format": "s",
          "label": "Duration"
        }
      ],
      "alert": {
        "name": "High Latency",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [2]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": ["A", "5m", "now"]
            },
            "reducer": {
              "type": "avg"
            },
            "type": "query"
          }
        ]
      }
    },
    {
      "title": "RabbitMQ Queue Status",
      "type": "graph",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "expr": "rabbitmq_queue_messages{queue=~\"notification.*\"}",
          "legendFormat": "Queue Size"
        }
      ],
      "yaxes": [
        {
          "format": "short",
          "label": "Messages"
        }
      ],
      "alert": {
        "name": "Queue Backlog",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [1000]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": ["A", "5m", "now"]
            },
            "reducer": {
              "type": "avg"
            },
            "type": "query"
          }
        ]
      }
    },
    {
      "title": "Error Rate",
      "type": "graph",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "expr": "rate(notification_errors_total[5m])",
          "legendFormat": "Errors/sec"
        }
      ],
      "yaxes": [
        {
          "format": "ops",
          "label": "Errors/sec"
        }
      ],
      "alert": {
        "name": "High Error Rate",
        "conditions": [
          {
            "evaluator": {
              "type": "gt",
              "params": [0.05]
            },
            "operator": {
              "type": "and"
            },
            "query": {
              "params": ["A", "5m", "now"]
            },
            "reducer": {
              "type": "avg"
            },
            "type": "query"
          }
        ]
      }
    },
    {
      "title": "Memory Usage",
      "type": "gauge",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 20
      },
      "targets": [
        {
          "expr": "process_resident_memory_bytes{job=\"notification-service\"} / 1024 / 1024",
          "legendFormat": "Memory (MB)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 2048,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 1024, "color": "yellow" },
              { "value": 1536, "color": "red" }
            ]
          },
          "unit": "megabytes"
        }
      }
    },
    {
      "title": "CPU Usage",
      "type": "gauge",
      "datasource": "prometheus",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 20
      },
      "targets": [
        {
          "expr": "rate(process_cpu_seconds_total{job=\"notification-service\"}[5m]) * 100",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "max": 100,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "value": null, "color": "green" },
              { "value": 60, "color": "yellow" },
              { "value": 80, "color": "red" }
            ]
          },
          "unit": "percent"
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "instance",
        "type": "query",
        "datasource": "prometheus",
        "query": "label_values(up{job=\"notification-service\"}, instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "sort": 1
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  }
}