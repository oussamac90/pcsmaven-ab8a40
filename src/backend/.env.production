# API Gateway Configuration
# Server Settings
PORT=3000
API_PREFIX=/api/v1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
COMPRESSION_ENABLED=true
CORS_ALLOWED_ORIGINS=https://pcs.com,https://admin.pcs.com
REQUEST_TIMEOUT_MS=5000

# Authentication Settings
JWT_SECRET=secure_jwt_secret_key
JWT_EXPIRES_IN=1h
JWT_ALGORITHM=HS256
JWT_ISSUER=pcs-api-gateway
JWT_AUDIENCE=pcs-services
AUTH0_DOMAIN=pcs.auth0.com
AUTH0_CLIENT_ID=auth0_client_id
AUTH0_CLIENT_SECRET=auth0_client_secret
AUTH0_AUDIENCE=https://api.pcs.com
AUTH0_CALLBACK_URL=https://api.pcs.com/callback
API_KEY_HEADER=X-API-Key
API_KEY_EXPIRY_DAYS=90
API_KEY_ALGORITHM=SHA-256
MFA_ENABLED=true
PASSWORD_POLICY_MIN_LENGTH=12
PASSWORD_POLICY_REQUIRE_NUMBERS=true
PASSWORD_POLICY_REQUIRE_SPECIAL_CHARS=true

# Monitoring Settings
ENABLE_REQUEST_LOGGING=true
ENABLE_RESPONSE_LOGGING=true
ENABLE_ERROR_TRACKING=true
APM_SERVICE_NAME=pcs-api-gateway
DATADOG_API_KEY=datadog_api_key
SENTRY_DSN=sentry_dsn

# Core Service Configuration
# Database Settings
DB_HOST=production-db-host
DB_PORT=5432
DB_NAME=pcs_db
DB_USER=db_user
DB_PASSWORD=db_password
DB_MAX_POOL_SIZE=50
DB_MIN_IDLE=10
DB_IDLE_TIMEOUT=300000
DB_CONNECTION_TIMEOUT=20000
DB_SSL_MODE=verify-full
DB_SSL_CERT=/path/to/cert

# Cache Settings
REDIS_HOST=redis-host
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_SSL=true
REDIS_CLUSTER_MODE=true
REDIS_KEY_PREFIX=pcs_prod
CACHE_TTL=3600

# Server Settings
SERVER_PORT=8080
COMPRESSION_ENABLED=true
MAX_THREADS=200
MIN_SPARE_THREADS=20
MAX_CONNECTIONS=10000
CONNECTION_TIMEOUT=20000
ENABLE_GRACEFUL_SHUTDOWN=true
SHUTDOWN_TIMEOUT=30

# Document Service Configuration
# Server Settings
PROJECT_NAME=PCS Document Service
VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=false
MAX_WORKERS=4
WORKER_CLASS=uvicorn.workers.UvicornWorker
KEEP_ALIVE=65

# MongoDB Settings
MONGODB_URL=mongodb://mongo-host:27017
MONGODB_DB_NAME=pcs_documents
MONGODB_USER=mongo_user
MONGODB_PASSWORD=mongo_password
MONGODB_AUTH_SOURCE=admin
MONGODB_SSL=true
MONGODB_REPLICA_SET=rs0

# Document Processing Settings
MAX_DOCUMENT_SIZE_MB=10
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,xls,xlsx
DOCUMENT_STORAGE_PATH=/mnt/documents
ENABLE_VIRUS_SCAN=true
RETENTION_PERIOD_DAYS=365
ENABLE_VERSIONING=true

# Monitoring Settings
PROMETHEUS_METRICS_PATH=/metrics
JAEGER_AGENT_HOST=jaeger-agent
JAEGER_AGENT_PORT=6831
ENABLE_PROFILING=true
PROFILER_PORT=8000

# Notification Service Configuration
# RabbitMQ Settings
RABBITMQ_HOST=rabbitmq-host
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=rmq_user
RABBITMQ_PASSWORD=rmq_password
RABBITMQ_VHOST=/
RABBITMQ_SSL=true
RABBITMQ_HEARTBEAT=60
RABBITMQ_CHANNEL_POOL_SIZE=10

# Email Settings
SMTP_HOST=smtp.provider.com
SMTP_PORT=587
SMTP_USER=smtp_user
SMTP_PASSWORD=smtp_password
EMAIL_FROM=noreply@pcs.com
EMAIL_TEMPLATE_DIR=/app/templates
MAX_RETRIES=3
RETRY_DELAY=5000

# WebSocket Settings
WS_PORT=8085
WS_PATH=/notifications
WS_MAX_CONNECTIONS=10000
WS_PING_INTERVAL=30
WS_PING_TIMEOUT=10
ENABLE_SSL=true

# Global Settings
NODE_ENV=production
LOG_LEVEL=info