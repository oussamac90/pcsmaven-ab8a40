# API Gateway Configuration
PORT=3000
API_VERSION=v1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
CORS_ORIGIN=http://localhost:5173

# JWT Authentication
JWT_SECRET=dev_jwt_secret_key
JWT_EXPIRES_IN=1h
JWT_ALGORITHM=HS256
JWT_ISSUER=pcs-api-gateway
JWT_AUDIENCE=pcs-services

# Auth0 Configuration
AUTH0_DOMAIN=dev-pcs.auth0.com
AUTH0_CLIENT_ID=dev_client_id
AUTH0_CLIENT_SECRET=dev_client_secret
AUTH0_AUDIENCE=https://dev-api.pcs.com
AUTH0_CALLBACK_URL=http://localhost:3000/callback

# API Key Configuration
API_KEY_HEADER=X-API-Key
API_KEY_EXPIRY_DAYS=90
API_KEY_ALGORITHM=SHA-256

# Core Service Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=pcs_db
DB_USER=pcs_user
DB_PASSWORD=dev_password

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# JPA/Hibernate Configuration
HIBERNATE_DDL_AUTO=update
JPA_SHOW_SQL=true
SERVER_PORT=8080

# MongoDB Document Service Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=pcs_documents
MAX_DOCUMENT_SIZE_MB=10
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,xls,xlsx

# Observability Configuration
PROMETHEUS_METRICS_PATH=/metrics
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# RabbitMQ Configuration
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# SMTP Configuration for Notifications
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=dev_user
SMTP_PASSWORD=dev_password

# WebSocket Configuration
SOCKET_PORT=3001

# Global Settings
NODE_ENV=development
DEBUG=true