# Global Configuration
NODE_ENV=staging
LOG_LEVEL=debug

# API Gateway Configuration
PORT=3000
API_VERSION=v1
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
CORS_ORIGIN=https://staging.pcs.com

# JWT Configuration
JWT_SECRET=staging_jwt_secret_key
JWT_EXPIRES_IN=1h
JWT_ALGORITHM=HS256
JWT_ISSUER=pcs-api-gateway
JWT_AUDIENCE=pcs-services

# Auth0 Configuration
AUTH0_DOMAIN=staging-pcs.auth0.com
AUTH0_CLIENT_ID=staging_client_id
AUTH0_CLIENT_SECRET=staging_client_secret
AUTH0_AUDIENCE=https://staging-api.pcs.com
AUTH0_CALLBACK_URL=https://staging-api.pcs.com/callback

# API Key Configuration
API_KEY_HEADER=X-API-Key
API_KEY_EXPIRY_DAYS=90
API_KEY_ALGORITHM=SHA-256

# Core Service Database Configuration
DB_HOST=staging-db-host
DB_PORT=5432
DB_NAME=pcs_staging_db
DB_USER=staging_user
DB_PASSWORD=staging_password

# Redis Cache Configuration
REDIS_HOST=staging-redis-host
REDIS_PORT=6379

# Core Service JPA Configuration
HIBERNATE_DDL_AUTO=validate
JPA_SHOW_SQL=false

# Core Service Server Configuration
SERVER_PORT=8080
COMPRESSION_ENABLED=true
MAX_THREADS=100
MIN_SPARE_THREADS=10
MAX_CONNECTIONS=5000

# Document Service MongoDB Configuration
MONGODB_URL=mongodb://staging-mongo-host:27017
MONGODB_DB_NAME=pcs_staging_documents
MAX_DOCUMENT_SIZE_MB=10
ALLOWED_DOCUMENT_TYPES=pdf,doc,docx,xls,xlsx

# Document Service Monitoring Configuration
PROMETHEUS_METRICS_PATH=/metrics
JAEGER_AGENT_HOST=staging-jaeger-agent
JAEGER_AGENT_PORT=6831

# Notification Service RabbitMQ Configuration
RABBITMQ_HOST=staging-rabbitmq-host
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=staging_rmq_user
RABBITMQ_PASSWORD=staging_rmq_password
RABBITMQ_VHOST=/

# Notification Service Email Configuration
SMTP_HOST=smtp.staging.provider.com
SMTP_PORT=587
SMTP_USER=staging_smtp_user
SMTP_PASSWORD=staging_smtp_password
EMAIL_FROM=noreply@staging.pcs.com

# Notification Service WebSocket Configuration
SOCKET_PORT=8085
WS_PATH=/notifications