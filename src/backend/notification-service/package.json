{
  "name": "@pcs/notification-service",
  "version": "1.0.0",
  "private": true,
  "main": "dist/app.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "prestart": "npm run build",
    "start": "node dist/app.js",
    "start:prod": "NODE_ENV=production node dist/app.js",
    "dev": "ts-node-dev --respawn src/app.ts",
    "build": "tsc",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint . --ext .ts",
    "clean": "rimraf dist",
    "security": "npm audit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "amqplib": "^0.10.0",
    "winston": "^3.11.0",
    "cors": "^2.8.5",
    "nodemailer": "^6.9.4",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "typescript": "^5.1.6",
    "@types/express": "^4.17.17",
    "@types/amqplib": "^0.10.1",
    "@types/cors": "^2.8.13",
    "@types/node": "^20.4.5",
    "@types/jest": "^29.5.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "rimraf": "^5.0.0"
  }
}