{
  "name": "port-community-system-api-gateway",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint . --ext .ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "security:audit": "npm audit",
    "docs": "typedoc --out docs src",
    "format": "prettier --write \"src/**/*.ts\"",
    "prepare": "husky install"
  },
  "dependencies": {
    "express": "^4.18.2",
    "typescript": "^4.9.5",
    "helmet": "^6.0.1",
    "cors": "^2.8.5",
    "compression": "^1.7.4",
    "morgan": "^1.10.0",
    "express-rate-limit": "^6.7.0",
    "jsonwebtoken": "^9.0.0",
    "express-validator": "^7.0.1",
    "http-proxy-middleware": "^2.0.6",
    "winston": "^3.8.2",
    "prom-client": "^14.2.0",
    "express-openapi-validator": "^5.0.1",
    "express-winston": "^4.2.0",
    "body-parser": "1.20.2",
    "dotenv": "^16.3.1",
    "express-prometheus-middleware": "^1.2.0",
    "opossum": "7.1.0",
    "rate-limiter-flexible": "^2.4.1",
    "socket.io": "4.7.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/cors": "^2.8.13",
    "@types/morgan": "^1.9.4",
    "@types/compression": "^1.7.2",
    "@types/jsonwebtoken": "^9.0.2",
    "@typescript-eslint/eslint-plugin": "^5.59.7",
    "@typescript-eslint/parser": "^5.59.7",
    "@types/node": "^20.4.5",
    "@types/socket.io": "^3.0.0",
    "@types/jest": "^29.5.1",
    "eslint": "^8.41.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "typedoc": "^0.24.7",
    "prettier": "^2.8.8",
    "husky": "^8.0.3",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.2.1",
    "lint-staged": "^13.2.3",
    "npm-run-all": "^4.1.5"
  }
}