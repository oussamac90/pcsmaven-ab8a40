REACT_APP_API_URL=https://api.pcs.production/api/v1
REACT_APP_API_TIMEOUT=30000

# WebSocket Configuration
REACT_APP_SOCKET_URL=wss://socket.pcs.production
REACT_APP_SOCKET_RECONNECTION_ATTEMPTS=5
REACT_APP_SOCKET_RECONNECTION_DELAY=1000

# Environment
REACT_APP_ENV=production

# Authentication Configuration
REACT_APP_AUTH_DOMAIN=auth.pcs.production
REACT_APP_AUTH_CLIENT_ID=${AUTH0_CLIENT_ID}
REACT_APP_AUTH_AUDIENCE=https://api.pcs.production

# Monitoring and Analytics
REACT_APP_ENABLE_ANALYTICS=true
REACT_APP_LOG_LEVEL=error