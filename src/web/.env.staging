VITE_APP_ENV=staging

# API Configuration
VITE_APP_API_URL=https://api-staging.pcs.com/api/v1
VITE_APP_TIMEOUT=30000

# WebSocket Configuration
VITE_APP_SOCKET_URL=wss://ws-staging.pcs.com
VITE_APP_RECONNECTION_ATTEMPTS=5
VITE_APP_RECONNECTION_DELAY=1000

# Authentication Configuration
VITE_APP_AUTH_DOMAIN=auth-staging.pcs.com
VITE_APP_AUTH_CLIENT_ID=pcs-web-staging

# Monitoring and Error Tracking
VITE_APP_SENTRY_DSN=https://sentry-staging.pcs.com
VITE_APP_ENABLE_LOGS=true
VITE_APP_ENABLE_PERFORMANCE_MONITORING=true
VITE_APP_ENABLE_ERROR_BOUNDARIES=true

# Upload Limits
VITE_APP_MAX_UPLOAD_SIZE=50000000

# Session Management
VITE_APP_IDLE_TIMEOUT=1800000
VITE_APP_SESSION_TIMEOUT=3600000